# Copy this file to ".env" and change the values. Never commit ".env" to GitHub.
# Use only letters and digits in POSTGRES_PASSWORD (it is placed inside a URL).

POSTGRES_DB=universitydb
POSTGRES_USER=uniuser
POSTGRES_PASSWORD=ChangeThisDbPassword123

# Long random text used to sign login sessions. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value

# First administrator. The password is hashed before being stored in the database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisAdminPassword
